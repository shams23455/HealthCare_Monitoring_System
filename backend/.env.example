PROJECT_NAME="Livestock Health Monitoring API"
ENVIRONMENT="development"
API_V1_STR="/api"

# Database Configuration (PostgreSQL in production / Docker, or SQLite for zero-setup local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/livestock_db"
# DATABASE_URL="sqlite:///./dev_livestock.db"

# Security & JWT Token (Change SECRET_KEY in production!)
SECRET_KEY="super-secret-key-change-this-in-production-livestock-health"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI/ML Risk Model Adapter & Thresholds
MODEL_TYPE="hybrid"           # options: 'rule_based', 'ml', 'hybrid'
MIN_CONFIDENCE=0.60          # Safety threshold below which automated conclusion is deferred
DATASET_PATH="data"
RESULTS_PATH="results"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
